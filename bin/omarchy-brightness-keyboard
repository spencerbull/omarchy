#!/bin/bash

# omarchy:summary=Adjust keyboard backlight brightness using available steps.
# omarchy:args=[--no-osd] <up|down|cycle|off|restore>

no_osd=0
if [[ ${1:-} == "--no-osd" ]]; then
  no_osd=1
  shift
fi

direction="${1:-up}"

# Find keyboard backlight device (look for *kbd_backlight* pattern in leds class).
leds_dir="${OMARCHY_LEDS_DIR:-/sys/class/leds}"
device=""
for candidate in "$leds_dir"/*kbd_backlight*; do
  if [[ -e $candidate ]]; then
    device="$(basename "$candidate")"
    break
  fi
done

if [[ -z $device ]]; then
  echo "No keyboard backlight device found" >&2
  exit 1
fi

max_brightness="$(brightnessctl -d "$device" max)"
current_brightness="$(brightnessctl -d "$device" get)"

if [[ ! $max_brightness =~ ^[1-9][0-9]*$ ]] ||
  [[ ! $current_brightness =~ ^[0-9]+$ ]] ||
  (( current_brightness > max_brightness )); then
  echo "Invalid keyboard backlight brightness" >&2
  exit 1
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/brightness/keyboard"
state_file="$state_dir/$device"

save_brightness() {
  local brightness="$1"

  (( brightness > 0 )) || return 0
  mkdir -p "$state_dir" || return 1
  printf '%s\n' "$brightness" >"$state_file"
}

if [[ $direction == "off" ]]; then
  # Some keyboard firmware reports zero after its own inactivity timeout even
  # though input can still wake it. Do not replace the last lit state or turn
  # that temporary zero into an explicit off state.
  if (( current_brightness > 0 )); then
    save_brightness "$current_brightness" || exit 1
    brightnessctl -d "$device" set 0 >/dev/null || exit 1
  fi
  exit 0
elif [[ $direction == "restore" ]]; then
  saved_brightness=""
  [[ -r $state_file ]] && saved_brightness="$(<"$state_file")"

  if [[ ! $saved_brightness =~ ^[1-9][0-9]*$ ]] && (( current_brightness > 0 )); then
    saved_brightness=$current_brightness
  elif [[ ! $saved_brightness =~ ^[1-9][0-9]*$ ]]; then
    saved_brightness=$(( (max_brightness + 1) / 2 ))
  elif (( saved_brightness > max_brightness )); then
    saved_brightness=$max_brightness
  fi

  brightnessctl -d "$device" set "$saved_brightness" >/dev/null || exit 1
  save_brightness "$saved_brightness" || exit 1
  exit 0
fi

# Calculate step as 10% of max brightness. Keyboards with many levels (e.g. 512)
# need larger steps; keyboards with few levels (e.g. 3) fall back to step=1.
step=$(( max_brightness / 10 ))
(( step < 1 )) && step=1

if [[ $direction == "cycle" ]]; then
  new_brightness=$(( current_brightness + step ))
  (( new_brightness > max_brightness )) && new_brightness=0
elif [[ $direction == "up" ]]; then
  new_brightness=$(( current_brightness + step ))
  (( new_brightness > max_brightness )) && new_brightness=$max_brightness
else
  new_brightness=$(( current_brightness - step ))
  (( new_brightness < 0 )) && new_brightness=0
fi

# Set the new brightness.
brightnessctl -d "$device" set "$new_brightness" >/dev/null || exit 1
save_brightness "$new_brightness" || exit 1
(( no_osd )) || omarchy-osd -i keyboard -p "$(( new_brightness * 100 / max_brightness ))"
