#!/bin/bash

# omarchy:summary=Remove orphaned system packages after updates
# omarchy:requires-sudo=true

source "$OMARCHY_PATH/install/helpers/gb10-lifecycle.sh"
omarchy-guard-gb10-lifecycle "Orphan package removal" || exit 1

orphans=$(pacman -Qtdq || true)
if [[ -n $orphans ]]; then
  echo -e "\e[32m\nRemove orphan system packages\e[0m"
  for pkg in $orphans; do
    sudo pacman -Rs --noconfirm "$pkg" || true
  done
  echo
fi
